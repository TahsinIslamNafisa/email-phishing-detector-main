# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to git.

# VirusTotal (shared app-level API key, used for every connected user/account)
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# Encryption key used to store each user's email app-password at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Flask session signing key (any long random string)
FLASK_SECRET_KEY=change_me_to_something_random

# Optional: Telegram alerts (shared across all users, sent for every phishing hit)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Slack alerts (Incoming Webhook URL)
SLACK_WEBHOOK_URL=
